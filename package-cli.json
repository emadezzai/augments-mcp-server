{
  "name": "augments-mcp",
  "version": "1.0.0",
  "description": "Augments MCP Server - Auto Installation & Management CLI",
  "type": "module",
  "main": "scripts/auto-install.ts",
  "bin": {
    "augments-mcp": "./scripts/auto-install.ts"
  },
  "scripts": {
    "build": "tsc scripts/auto-install.ts --outDir dist --module esnext --target es2020 --moduleResolution node --esModuleInterop --skipLibCheck",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "claude",
    "cline",
    "ai",
    "documentation",
    "typescript",
    "auto-install"
  ],
  "author": "Augments",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "scripts/auto-install.ts",
    "dist/auto-install.js",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/emadezzai/augments-mcp-server"
  }
}