# ===========================================
# Augments MCP Server - Local Configuration
# ===========================================
# 100% Local & Free - No paid services required!
# 
# The server works WITHOUT any API keys using:
# - npm CDN (unpkg/jsdelivr) for TypeScript definitions
# - GitHub for code examples (optional token for higher limits)
# - Local file cache instead of Redis
#
# Minimax and Chutes are OPTIONAL enhancements.

# ===========================================
# Server Configuration (Required)
# ===========================================
PORT=3000
HOST=localhost
NODE_ENV=development

# ===========================================
# GitHub (Optional - for examples fallback)
# ===========================================
# Without token: 60 requests/hour
# With token: 5000 requests/hour
# GITHUB_TOKEN=your_github_token_here

# ===========================================
# Minimax (Optional - for enhanced query parsing)
# ===========================================
# Get your API key from: https://www.minimax.io
# MINIMAX_API_KEY=your_minimax_api_key_here
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_MODEL=abab6.5s-chat

# ===========================================
# Chutes (Optional - for enhanced examples)
# ===========================================
# Get your API key from: https://chutes.ai
# CHUTES_API_KEY=your_chutes_api_key_here
# CHUTES_BASE_URL=https://api.chutes.ai/v1

# ===========================================
# Cache Settings
# ===========================================
# Local file cache path
CACHE_PATH=./.cache

# Maximum entries in memory cache
CACHE_MAX_ENTRIES=300

# Auto-cache documentation on startup
ENABLE_AUTO_CACHE=false

# Hot reload in development
ENABLE_HOT_RELOAD=true

# ===========================================
# Rate Limiting (Local, no Redis needed)
# ===========================================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=debug

# ===========================================
# Feature Flags
# ===========================================
# Use Minimax for query parsing (requires MINIMAX_API_KEY)
USE_AI_QUERY_PARSING=false

# Use Chutes for examples (requires CHUTES_API_KEY)
USE_CHUTES_EXAMPLES=false